    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "4.0.13",
    "electron": "^44.7.2",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "playwright": "^1.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.1.11",
    "vitest": "4.0.13"
  }
